<Window x:Class="SoborSmartReport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sortImage="clr-namespace:SoborSmartReport.SortImage"
        Title="엑셀보고서 도우미"
        Width="1440" Height="920"
        MinWidth="500" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Malgun Gothic"
        FontSize="13"
        Icon="/Assets/app_icon.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6D4AFF"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#F0ECFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#25263A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#777B91"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#34364A"/>
            <Setter Property="BorderBrush" Value="#DDE0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,8,8"/>
            <Setter Property="BorderBrush" Value="#DDE0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Foreground" Value="#60647A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측 사이드바 -->
        <Grid Grid.Column="0" Margin="20,20,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Border x:Name="SidebarBorder" Grid.Row="0" Background="#FFFFFF"
                BorderBrush="#E7E8F0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="22,24,18,20">
                        <Border Width="42" Height="42" CornerRadius="12"
                            Background="#6D4AFF" HorizontalAlignment="Left">
                            <TextBlock Text="S" Foreground="White"
                                   FontSize="25" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SOBOR SOFT" FontSize="17"
                                   FontWeight="Bold" Foreground="#25263A"
                                   Margin="0,13,0,3"/>
                            <TextBlock Text="Excel Report Mate" FontSize="11"
                                   Foreground="#85899D"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="12,0,12,0">
                        <TextBlock Text="WORKSPACE" FontSize="10"
                               FontWeight="Bold" Foreground="#9A9DB0"
                               Margin="12,0,0,10"/>

                        <Button Content="▦   보고서 작업"
                            HorizontalContentAlignment="Left"
                            Background="#F0ECFF" Foreground="#6D4AFF"
                            BorderThickness="0" Click="NavigateReport_Click"/>

                        <Button Content="✓ 정정 및 검증"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0" Click="NavigateCorrection_Click"/>

                        <Button Content="▧ 이미지 정렬"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0" Click="NavigateAlign_Click"/>

                        <Button Content="▣ 이미지 삽입 / OCR"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0" Click="NavigateInsert_Click"/>

                        <Button Content="⇩ 파일 다운로드"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0" Click="NavigateDownload_Click"/>

                        <Button Content=" 이미지 순서 변경"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0" Click="NavigateDownload_Click"/>

                        <Separator Margin="8,16,8,16" Background="#E9EAF1"/>

                        <TextBlock Text="SYSTEM" FontSize="10"
                               FontWeight="Bold" Foreground="#9A9DB0"
                               Margin="12,0,0,10"/>

                        <Button Content="≡   작업 로그"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0" Click="NavigateLog_Click"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="14"
                        Background="#F7F5FF" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="SOBOR SOFT"
                                   Foreground="#6D4AFF"
                                   FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text=".NET Desktop Edition"
                                   Foreground="#777B91" FontSize="10"
                                   Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Margin="0,0,0,0">
                    <Button x:Name="btnNavigateHide"
                            Content="&lt;"
                            Margin="0,0,0,0"
                            Foreground="#FF6D4AFF"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        BorderThickness="0" Click="NavigateHide_Click" FontWeight="Bold" FontSize="15" FontFamily="Yet R"/>
                    <!--Button Content="<"
                        Foreground="#6D4AFF" FontSize="10"
                        HorizontalContentAlignment="Left"
                        BorderThickness="0" Click="NavigateHide_Click"/-->
                </StackPanel>
            </Grid>

        </Grid>

        <Grid Grid.Column="1" Margin="0,20,0,20" Background="#FFB690DE"/>

        <!-- 메인 영역 -->
        <Grid Grid.Column="2" Margin="10,20,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>

            <!-- 상단 제목 -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="엑셀보고서 도우미"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="반복적인 보고서 작업을 간편하게 자동화하세요."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="White"
                        BorderBrush="#E5E7EF" BorderThickness="1"
                        CornerRadius="9" Padding="13,9"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#2BB673"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="로컬 작업 환경"
                                   Foreground="#55596E"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 보고서 파일 선택 -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Margin="0,0,0,16"
                    AllowDrop="True"
                    DragEnter="DropArea_DragEnter"
                    DragOver="DropArea_DragOver"
                    Drop="DropArea_Drop"
                    Background="White"
                    IsHitTestVisible="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="#FFF4D9" VerticalAlignment="Center">
                        <TextBlock Text="XLS" Foreground="#B87B00"
                                   FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="작업할 보고서 파일"
                                   FontWeight="SemiBold"
                                   Foreground="#25263A"/>
                        <TextBox x:Name="tbQuantityFile"
                                 Margin="0,5,0,0"
                                 Text=""
                                 IsHitTestVisible="False"
                                 TextChanged="tbQuantityFile_TextChanged"
                                 ToolTip="엑셀 보고서 파일 경로"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="btnQuantityFile"
                            Content="파일 선택"
                            VerticalAlignment="Center"
                            Margin="0"
                            Click="btnQuantityFile_Click"/>
                </Grid>
            </Border>

            <!-- 탭 -->
            <TabControl x:Name="mainTabs" Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="mainTabs_SelectionChanged">

                <!-- 1. 보고서 작업 -->
                <TabItem Header="보고서 작업">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,0,8">
                            <TextBlock Text="보고서 편집"
                                       Style="{StaticResource SectionTitle}"/>

                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="01  표지 이미지"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="표지의 이미지를 가운데로 정렬합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnGapjiPictureRelocate"
                                                Background="#FFE9DCFC"
                                                Content="표지 이미지 정렬"
                                                Click="btnGapjiPictureRelocate_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="02  페이지 번호"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="갑지를 제외한 페이지 번호를 갱신합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnPageNumber"
                                                Background="#FFE9DCFC"
                                                Content="페이지 번호 갱신"
                                                Click="btnPageNumber_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="03  PDF 내보내기"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="보고서를 PDF 파일로 저장합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnExportForPdf"
                                                Background="#FFE9DCFC"
                                                Content="PDF 내보내기"
                                                Click="btnExportForPdf_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="04  페이지 구분선"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="페이지 구분선 설정을 점검합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="button1"
                                                Background="#FFE9DCFC"
                                                Content="구분선 확인"
                                                Click="button1_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="05  서명 삽입"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="보고서에 검사자 서명을 추가합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnInsertSign"
                                                Background="#FFE9DCFC"
                                                Content="서명 삽입"
                                                Click="btnInsertSign_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="06  바닥글 로고"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="보고서 바닥글에 사용할 로고를 변경합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnChangeFooterLogo"
                                                Content="로고 변경"
                                                Click="btnChangeFooterLogo_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="07  날짜 갱신"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="보고서의 점검 날짜를 수정합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnSeasonCorrect"
                                                Background="#FFE9DCFC"
                                                Content="날짜 갱신"
                                                Click="btnSeasonCorrect_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="08  검사자 변경"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="보고서에 기재된 검사자 정보를 변경합니다."
                                                   TextWrapping="Wrap"
                                                   Foreground="#777B91"
                                                   Margin="0,8,0,14"/>
                                        <Button x:Name="btnChangeInspector"
                                                Background="#FFE9DCFC"
                                                Content="검사자 변경"
                                                Click="btnChangeInspector_Click"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. 정정 및 검증 -->
                <TabItem Header="정정 및 검증">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,0,8">
                            <TextBlock Text="정정 작업"
                                       Style="{StaticResource SectionTitle}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="정정 목록 및 페이지 확인"
                                               FontSize="15" FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="btnUpdateJuapList"
                                                Content="정정 목록 갱신"
                                                Click="btnUpdateJuapList_Click"/>
                                        <Button x:Name="btErrorPageUpdate"
                                                Content="부적합 페이지 갱신"
                                                Click="btErrorPageUpdate_Click"/>
                                        <Button x:Name="btnConfirmJulyeon"
                                                Content="오류 확인"
                                                Click="btnConfirmJulyeon_Click"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="checkBoxCorrect"
                                              Content="정정 옵션 적용"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 3. 이미지 정렬 -->
                <TabItem Header="이미지 정렬">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,0,8">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="이미지 정렬 및 최적화"
                                               Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel>
                                        <Button x:Name="btnDeletePicture"
                                                Content="시트 이미지 삭제"
                                                Click="btnDeletePicture_Click"/>
                                        <Button x:Name="btnCompressImages"
                                                Content="이미지 크기 최적화"
                                                Click="btnCompressImages_Click"/>
                                        <Button x:Name="btnSnapImage"
                                                Content="셀에 이미지 맞춤"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="btnSnapImage_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="정렬 대상 및 여백"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="대상 시트 이름"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="textBoxSheetForSnapImage"
                                             Text=""/>

                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="왼쪽 여백"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="textBoxImageAlignLeftGap"
                                                     Text="0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="위쪽 여백"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="textBoxImageAlignTopGap"
                                                     Text="0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="오른쪽 여백"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="textBoxImageAlignRightGap"
                                                     Text="0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="아래쪽 여백"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="textBoxImageAlignBottomGap"
                                                     Text="0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4. 이미지 삽입 / OCR -->
                <TabItem Header="이미지 삽입 / OCR">
                        <StackPanel Margin="4,18,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                        Text="이미지 삽입 설정"
                                        Style="{StaticResource SectionTitle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,5"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                    x:Name="btnQuntityFileRun"
                                    Content="선택한 이미지 삽입 실행"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="10,0,40,0"
                                    Click="btnQuntityFileRun_Click"
                                    Background="#FFE9DCFC"
                                    HorizontalContentAlignment="Stretch" Foreground="#FF222335" FontWeight="Bold" FontSize="15"/>
                            </Grid>
                            <Separator Margin="0,12,0,12"
                                            Background="#FFB4BEEA"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="삽입할 이미지 유형"
                                               FontSize="15" FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="checkBox"
                                          Grid.Row="0" Grid.Column="0"
                                          Text="[항목]" TextAlignment="Center" FontSize="11"
                                                 Background="#55aaaaaa"/>
                                        <TextBox x:Name="Sheet"
                                         Text="[시트 이름]"
                                         Grid.Row="0" Grid.Column="1"
                                         ToolTip="열화상 시트이름" TextAlignment="Center"
                                                  FontSize="11"
                                                 Background="#55aaaaaa"/>
                                                                        <TextBox x:Name="Folder"
                                         Text="[폴더 이름]"
                                         Grid.Row="0" Grid.Column="2"
                                         ToolTip="열화상 경로" TextAlignment="Center" FontSize="11"
                                                 Background="#55aaaaaa"/>
                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                 Text="[선택]" TextAlignment="Center" FontSize="11"
                                                 Background="#55aaaaaa"/>
                                        <TextBox x:Name="Copy"
                                            Grid.Row="0" Grid.Column="4"
                                            Text="[시트 복서]" TextAlignment="Center" FontSize="11"
                                            Background="#55aaaaaa"/>
                                        <TextBox x:Name="ocr"
                                          Grid.Row="0" Grid.Column="5"
                                          Text="[기타]" TextAlignment="Center" FontSize="11"
                                                 Background="#55aaaaaa"/>

                                        <CheckBox x:Name="checkBoxThermal"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Content="열화상 이미지"/>
                                        <TextBox x:Name="tbQuaterSheet"
                                                 Text="별지7호"
                                                 Grid.Row="1" Grid.Column="1"
                                                 ToolTip="열화상 시트이름"/>
                                        <TextBox x:Name="tbQuaterFolder"
                                                 Text="07 열화상"
                                                 Grid.Row="1" Grid.Column="2"
                                                 ToolTip="열화상 경로"/>
                                        <Button Grid.Row="1" Grid.Column="3"
                                                Content="폴더 선택"
                                                Click="btnSelectThermalFolder_Click"
                                                Background="#FFE9DCFC"/>
                                        <CheckBox x:Name="checkBoxCopy"
                                                  Grid.Row="1" Grid.Column="4"
                                                  Content="시트복사하여 파일 생성"/>
                                        <CheckBox x:Name="checkBoxOcr"
                                                  Grid.Row="1" Grid.Column="5"
                                                  Content="OCR을 사용하여 측정값 자동 입력"/>


                                        <CheckBox x:Name="checkBoxQuantity"
                                                  Grid.Row="2" Grid.Column="0"
                                                  Content="PDF 파일"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 x:Name="tbQuantitySheet"
                                                 Text="PDF"
                                                 ToolTip="PDF 시트이름"/>
                                        <TextBox x:Name="tbQuantityFolder"
                                                 Grid.Row="2" Grid.Column="2"
                                                 Text="PDF"
                                                 ToolTip="PDF 파일 시트 이름"/>
                                        <Button Grid.Row="2" Grid.Column="3"
                                                Content="폴더 선택"
                                                Click="btnSelectQuantityFolder_Click"
                                                Background="#FFE9DCFC"/>

                                        <CheckBox x:Name="checkBoxCorona"
                                                  Grid.Row="3" Grid.Column="0"
                                                  Content="점검　이미지"/>
                                        <TextBox Grid.Row="3" Grid.Column="1"/>
                                        <TextBox x:Name="textBox3"
                                                 Grid.Row="3" Grid.Column="2"
                                                 ToolTip="코로나 이미지 시트 이름"/>
                                        <Button Grid.Row="3" Grid.Column="3"
                                                Content="폴더 선택"
                                                Click="btnSelectCoronaFolder_Click"
                                                Background="#FFE9DCFC"/>

                                        <CheckBox x:Name="checkBoxPicture"
                                                  Grid.Row="4" Grid.Column="0"
                                                  Content="일반 사진"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"/>
                                        <TextBox x:Name="textBox4"
                                                 Grid.Row="4" Grid.Column="2"
                                                 ToolTip="사진 시트 이름"/>
                                        <Button Grid.Row="4" Grid.Column="3"
                                                Content="폴더 선택"
                                                Click="btnSelectPictureFolder_Click"
                                                Background="#FFE9DCFC"/>

                                        <CheckBox x:Name="checkBoxEquipment"
                                                  Grid.Row="5" Grid.Column="0"
                                                  Content="설비 이미지"/>
                                        <TextBox Grid.Row="5" Grid.Column="1"/>
                                        <TextBox x:Name="textBox5"
                                                 Grid.Row="5" Grid.Column="2"
                                                 ToolTip="설비 이미지 시트 이름"/>
                                        <Button Grid.Row="5" Grid.Column="3"
                                                Content="폴더 선택"
                                                Click="btnSelectEquipmentFolder_Click"
                                                Background="#FFE9DCFC"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <!-- 5. 파일 다운로드 -->
                <TabItem Header="파일 다운로드">
                    <Grid Margin="4,18,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="회사별 파일"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="회사명"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="tbCompany"
                                         ToolTip="검색할 회사명"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DataGrid x:Name="dgvFiles"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="White"/>
                        </Border>

                        <Button Grid.Row="2" x:Name="btnDownload"
                                Content="선택 파일 다운로드"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Click="btnDownload_Click"/>
                    </Grid>
                </TabItem>

                <!-- 6. 이미지 정렬 탭: 기존 tabSortImage 대응 -->
                <TabItem x:Name="tabSortImage" Header="이미지 순서">
                    <Grid Margin="4,18,0,8">
                        <!--Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="이미지 순서 관리"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="기존 이미지 정렬 기능을 이 영역에 연결할 수 있습니다."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border-->
                        <!--sortImage:FormSortImage/-->
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 하단 로그 -->
            <Border Grid.Row="3" Background="White"
                    BorderBrush="#E5E7EF" BorderThickness="1"
                    CornerRadius="12" Padding="14,10"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="작업 로그"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#25263A"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0"/>
                            <Button Content="전체"
                                    Padding="10,4" Margin="0,0,6,0"
                                    Click="ShowAllLog_Click"/>
                            <Button Content="정보"
                                    Padding="10,4" Margin="0,0,6,0"
                                    Click="ShowInfoLog_Click"/>
                            <Button Content="오류"
                                    Padding="10,4" Margin="0"
                                    Click="ShowErrorLog_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="실행 결과 및 오류 메시지"
                                   Foreground="#9296A9"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <RichTextBox x:Name="richTextBox1"
                                 Grid.Row="1"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="#FAFBFD"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>