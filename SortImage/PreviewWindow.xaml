<Window x:Class="SoborSmartReport.SortImage.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 크게 보기"
        Width="1300"
        Height="900"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        KeyDown="PreviewWindow_KeyDown"
        PreviewMouseWheel="PreviewWindow_PreviewMouseWheel">

    <DockPanel>
        <!-- 상단 도구 모음 -->
        <Border DockPanel.Dock="Top"
                Background="#F2F2F2"
                Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="◀ 이전"
                            Width="90"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="BtnPrev_Click"/>

                    <Button Content="다음 ▶"
                            Width="90"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="BtnNext_Click"/>

                    <Button Content="화면 맞춤"
                            Width="90"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="BtnFit_Click"/>

                    <Button Content="100%"
                            Width="70"
                            Height="34"
                            Click="Btn100_Click"/>
                </StackPanel>

                <TextBlock x:Name="lbInfo"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 이미지 표시 영역 -->
        <ScrollViewer x:Name="imageScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      CanContentScroll="False">

            <Grid x:Name="imageContainer"
                  MinWidth="{Binding ActualWidth,
                             ElementName=imageScroll}"
                  MinHeight="{Binding ActualHeight,
                              ElementName=imageScroll}">

                <Image x:Name="pictureBox"
                       Stretch="Fill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>