<UserControl x:Class="SoborSmartReport.SortImage.FormSortImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700"
             MinHeight="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- 상단 폴더 및 정렬 -->
        <DockPanel Grid.Row="0" Margin="10,5">
            <TextBlock Text="폴더" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="tbFolder" Width="500"
                     VerticalContentAlignment="Center"
                     KeyDown="TbFolder_KeyDown"/>
            <Button Content="폴더 선택" Margin="8,0,0,0"
                    Padding="12,5" Click="BtnFolder_Click"/>
            <Button Content="새로고침" Margin="8,0,0,0"
                    Padding="12,5" Click="BtnRefresh_Click"/>
            <TextBlock Text="정렬" Margin="25,0,8,0"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="cbSort" Width="150"
                      SelectedIndex="0"
                      SelectionChanged="CbSort_SelectionChanged">
                <ComboBoxItem Content="사용자 지정"/>
                <ComboBoxItem Content="파일명 ↑"/>
                <ComboBoxItem Content="파일명 ↓"/>
                <ComboBoxItem Content="수정일 ↑"/>
                <ComboBoxItem Content="수정일 ↓"/>
            </ComboBox>
        </DockPanel>

        <!-- 본문 -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 폴더 트리 -->
            <TreeView x:Name="tvFolders" Grid.Column="0"
                      SelectedItemChanged="TvFolders_SelectedItemChanged"/>

            <!-- 썸네일 -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD"
                    BorderThickness="1" Margin="6,0">
                <ListBox x:Name="lvImages"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="LvImages_SelectionChanged"
                         MouseDoubleClick="LvImages_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="LvImages_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="LvImages_PreviewMouseMove"
                         AllowDrop="True"
                         DragOver="LvImages_DragOver"
                         Drop="LvImages_Drop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{Binding ThumbnailWidth}"
                                        Margin="5">
                                <Border Background="White"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1">
                                    <Image Source="{Binding Thumbnail}"
                                           Width="{Binding ThumbnailWidth}"
                                           Height="{Binding ThumbnailHeight}"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Order,
                                    StringFormat={}{0:D3}}"
                                           FontWeight="Bold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding FileName}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="200"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 큰 미리 보기 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lbFileName"
                           Text="이미지를 선택하세요."
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="1" Background="#282828">
                    <Image x:Name="pbPreview" Stretch="Uniform"
                           MouseDown="PbPreview_MouseDown"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="◀ 이전" Width="100" Height="34"
                            Margin="5" Click="BtnPrev_Click"/>
                    <Button Content="다음 ▶" Width="100" Height="34"
                            Margin="5" Click="BtnNext_Click"/>
                </StackPanel>

                <TextBlock x:Name="lbInfo" Grid.Row="3"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- 하단 -->
        <DockPanel Grid.Row="2" Margin="10">
            <Button Content="▲ 위로" Width="80" Margin="0,5,8,5"
                    Click="BtnUp_Click"/>
            <Button Content="▼ 아래로" Width="80" Margin="0,5,8,5"
                    Click="BtnDown_Click"/>
            <Button Content="목록 제외" Width="90" Margin="0,5,15,5"
                    Click="BtnDelete_Click"/>

            <TextBlock Text="썸네일" VerticalAlignment="Center"/>
            <Slider x:Name="tbThumbSize" Minimum="80" Maximum="250"
                    Value="150" Width="150" Margin="8,0"
                    VerticalAlignment="Center"
                    ValueChanged="TbThumbSize_ValueChanged"/>

            <CheckBox x:Name="chkKeepOriginalName"
                      Content="순번 뒤에 원본 파일명 유지"
                      IsChecked="True"
                      VerticalAlignment="Center" Margin="8,0"/>

            <Button Content="정렬본 만들기" Width="140" Height="40"
                    Margin="15,0,0,0" DockPanel.Dock="Right"
                    Click="BtnMakeFolder_Click"/>
        </DockPanel>
    </Grid>
</UserControl>
